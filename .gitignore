# No trailing slash: a worktree that shares the main checkout's install does it with a symlink
# named `node_modules`, and `node_modules/` matches a directory only. So every such worktree had
# the link show up as untracked, and the host check that every top-level path is decided failed
# there and nowhere else, naming a path nobody had added on purpose.
node_modules
dist/
media/webview.js
media/webview.js.map

# KaTeX's stylesheet, fonts and licence, copied from node_modules by the build.
media/katex.css
media/katex-fonts/
media/katex-LICENSE.txt

# Mermaid's published module, its chunks and its licence, copied the same way.
media/mermaid/

# The editor's own chunks, written by the build: a grammar, and everything else a
# document only sometimes needs. Their names carry a hash, so they change every build.
media/editor/
*.vsix
.DS_Store
*.log
.vscode-test/

# test bundles
test/bundle.cjs
test/tables.bundle.cjs
test/textSync.bundle.cjs
test/host.bundle.cjs
test/prose.bundle.cjs
test/server.bundle.cjs
test/browserHost.bundle.cjs
test/dialect.bundle.cjs

# Real-world corpus, downloaded on demand by scripts/fetch-wild-corpus.mjs.
sample/wild/files/

# Sub-agent worktrees created by the harness. Whole nested checkouts, never committed.
.claude/worktrees/

# Local scratch for driving a real VS Code window: fixtures, profile, builds. Never committed.
.claude/scratch/
